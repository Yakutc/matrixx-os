{
  "name": "matrixx-os",
  "private": true,
  "version": "0.9.7",
  "type": "module",
  "description": "MATRIXX OS — recovery build. A fully interactive operating system in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "gh-pages -d dist --branch gh-pages --nojekyll",
    "shots": "node scripts/shots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/handjet": "^5.3.1",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gh-pages": "^6.3.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
